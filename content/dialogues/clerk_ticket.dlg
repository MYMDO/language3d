choice "Yes, please." -> 2 intent=1 vocab=203
choice "Just looking." -> 3 intent=2
choice "I like trains." -> 1 intent=3 vocab=113
node 2 speaker=npc lang=en cefr=A1 vocab=203,105 effect=GIVE_ITEM:2:1
